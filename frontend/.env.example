# Frontend Environment Variables
# Copy to .env.local and fill in your values

# API URL - Set to your deployed backend URL
# For local development, leave empty to use Vercel dev proxy
# For production, set to your backend URL (e.g., https://your-backend.onrender.com)
VITE_API_URL=

# Optional: Map configuration
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13